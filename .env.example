# Canton 이미지 버전
CANTON_VERSION=3.7.1

# 노드별 audience (Admin API JWT, ES256). 토큰의 aud 클레임이 이 값과 일치해야 해당 노드의 Admin API가 받아줍니다.
# 노드마다 다르게 두면 서명 키를 공유하더라도 토큰을 다른 노드에 재사용할 수 없습니다.
PARTICIPANT_ADMIN_AUDIENCE=https://canton.local/participant/admin
SEQUENCER_ADMIN_AUDIENCE=https://canton.local/sequencer/admin
MEDIATOR_ADMIN_AUDIENCE=https://canton.local/mediator/admin

POSTGRES_USER=canton
POSTGRES_PASSWORD=canton
